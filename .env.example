# Lumiere routes requests through OpenRouter. Keep this server-side only;
# never expose it to browser JavaScript or commit a populated .env file.
OPENROUTER_API_KEY=
# Optional: defaults to OpenRouter's automatic best-model router.
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_CHAT_MODEL=openrouter/auto
OPENROUTER_ANALYSIS_MODEL=openai/gpt-5.6-sol
OPENROUTER_BREAKDOWN_MODEL=openai/gpt-5.6-terra
OPENROUTER_IMPORT_MODEL=openrouter/auto

# Shared only between the Node API and the private Vercel Python PDF worker.
# Generate a long random value for Vercel; never expose it in browser code.
FILMSCRIPT_PDF_WORKER_SECRET=
# Optional override. Vercel discovers its same-deployment worker automatically.
# FILMSCRIPT_PDF_WORKER_URL=https://your-project.vercel.app/_filmscript/pdf

# Recurrente server credentials. Never expose the secret in frontend code.
RECURRENTE_SECRET_KEY=sk_test_or_live_
RECURRENTE_WEBHOOK_SECRET=whsec_
# Optional override used by automated/local integration tests.
RECURRENTE_API_URL=https://app.recurrente.com/api

# Each paid FilmScript tier must reference its own recurring Recurrente product.
# The backend refuses to create a checkout if the selected id is missing.
RECURRENTE_LUMIERE_PRODUCT_ID=
# Optional: use a Recurrente one-time product instead of the inline $5 item.
RECURRENTE_LUMIERE_RESET_PRODUCT_ID=
RECURRENTE_LUMIERE_AMOUNT_CENTS=1999
RECURRENTE_BASIC_PRODUCT_ID=
RECURRENTE_BASIC_AMOUNT_CENTS=1299
RECURRENTE_CURRENCY=USD
RECURRENTE_ACCOUNT_ID=

# Local persistence only. Leave FILMSCRIPT_DATA_DIR and FILMSCRIPT_DB_PATH
# unset on Vercel; the preview adapter automatically uses writable /tmp space.
# SQLite is used during development; this file must never be published with the
# frontend.
FILMSCRIPT_DATA_DIR=./data
# FILMSCRIPT_DB_PATH=./data/filmscript.sqlite
FILMSCRIPT_REFERENCE_STORAGE=local
FILMSCRIPT_CANVAS_STORAGE_PROVIDER=local

# AWS production object storage. Keep both providers as `local` on a laptop.
# In ECS set them to `s3`; the task IAM role supplies credentials automatically.
# Never place AWS access keys in this file.
# AWS_REGION=us-east-1
# FILMSCRIPT_S3_BUCKET=filmscript-production-private
# FILMSCRIPT_S3_PREFIX=filmscript

# URLs. They are the same locally. In production, PUBLIC_APP_URL is the Vercel
# frontend and API_URL/APP_URL are the public AWS backend. Prefer sibling
# custom domains such as app.example.com and api.example.com.
APP_URL=http://localhost:4173
PUBLIC_APP_URL=http://localhost:4173
API_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173
# Optional public ERP origin. Leave blank to disable anonymous funnel events.
ERP_API_URL=
ERP_ENVIRONMENT=test
PORT=4173

# Codex/local visual workflow. This is intentionally isolated from `data/`
# and must never be enabled in AWS/Vercel.
# FILMSCRIPT_PREVIEW_MODE=true
# FILMSCRIPT_PREVIEW_DATA_DIR=./data-preview

# Use None + true only for a temporary test where frontend and API are on
# unrelated sites. Sibling custom domains should keep Lax + true.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Google OAuth: use environment variables in production, or this JSON path locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=
PDF_PYTHON=python3
