# Existing Claude configuration
ANTHROPIC_API_KEY=

# Shared only between the Node API and the private Vercel Python PDF worker.
# Generate a long random value for Vercel; never expose it in browser code.
FILMSCRIPT_PDF_WORKER_SECRET=
# Optional override. Vercel discovers its same-deployment worker automatically.
# FILMSCRIPT_PDF_WORKER_URL=https://your-project.vercel.app/_filmscript/pdf

# Recurrente server credentials. Never expose the secret in frontend code.
RECURRENTE_SECRET_KEY=sk_test_or_live_
RECURRENTE_WEBHOOK_SECRET=whsec_
# Optional override used by automated/local integration tests.
RECURRENTE_API_URL=https://app.recurrente.com/api

# FilmScript Pro must reference a recurring Recurrente product. The backend
# refuses to create a checkout if this id is missing.
RECURRENTE_LUMIERE_PRODUCT_ID=
RECURRENTE_LUMIERE_AMOUNT_CENTS=2000
RECURRENTE_CURRENCY=USD
RECURRENTE_ACCOUNT_ID=

# Local persistence only. Leave FILMSCRIPT_DATA_DIR and FILMSCRIPT_DB_PATH
# unset on Vercel; the preview adapter automatically uses writable /tmp space.
# SQLite is used during development; this file must never be published with the
# frontend.
FILMSCRIPT_DATA_DIR=./data
# FILMSCRIPT_DB_PATH=./data/filmscript.sqlite
FILMSCRIPT_REFERENCE_STORAGE=local
FILMSCRIPT_CANVAS_STORAGE_PROVIDER=local

# URLs. They are the same locally. For a single-domain Vercel deployment set
# APP_URL, PUBLIC_APP_URL and API_URL to the final https:// project domain.
# If the frontend and backend are split, PUBLIC_APP_URL is the Vercel frontend
# and API_URL is the public backend URL.
APP_URL=http://localhost:4173
PUBLIC_APP_URL=http://localhost:4173
API_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173
PORT=4173

# Use None + true only when frontend and API live on different sites.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Google OAuth: use environment variables in production, or this JSON path locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=
PDF_PYTHON=python3
